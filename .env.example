POSTGRES_DB=spec2test
POSTGRES_USER=spec2test
POSTGRES_PASSWORD=spec2test

# ollama | openai | anthropic
SPEC2TEST_LLM_PROVIDER=ollama
SPEC2TEST_TEXT_MODEL=qwen3-coder:30b
SPEC2TEST_VISION_MODEL=qwen2.5vl:32b
# Optional semantic retrieval for reference-TC RAG. Run: ollama pull nomic-embed-text
SPEC2TEST_EMBEDDING_PROVIDER=ollama
SPEC2TEST_EMBEDDING_MODEL=nomic-embed-text
SPEC2TEST_RAG_TOP_K=6

# host.docker.internal resolves to the Docker host on Docker Desktop (Windows/Mac).
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Only needed if SPEC2TEST_LLM_PROVIDER=openai / anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
